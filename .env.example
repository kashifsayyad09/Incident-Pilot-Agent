# IncidentPilot AI — environment template. Copy to `.env` (never commit `.env`).

# ---- Mode -------------------------------------------------------------
# simulation = bundled sample incidents, no AWS calls (default)
# live       = read-only Boto3 calls against your AWS account
INCIDENTPILOT_MODE=simulation

# ---- API --------------------------------------------------------------
INCIDENTPILOT_API_HOST=0.0.0.0
INCIDENTPILOT_API_PORT=8000
# Comma-separated list of allowed browser origins
INCIDENTPILOT_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# Optional shared secret. If set, non-health endpoints require header X-API-Key.
INCIDENTPILOT_API_KEY=

# ---- AWS (live mode + Bedrock) ---------------------------------------
# Prefer an IAM role or SSO profile. Do NOT paste long-lived keys into files.
AWS_REGION=us-east-1
AWS_PROFILE=
# Bedrock model/inference-profile id used through the Strands Agents SDK
# (confirm availability in your region and account; set in Phase 3)
INCIDENTPILOT_BEDROCK_MODEL_ID=

# ---- Strands Decider 2B ----------------------------------------------
# Base URL of a running `strands-decider serve` (System One API). Empty = not configured,
# and the app reports Decider as unavailable. It never substitutes a fake decision.
#   pip install strands-decider
#   strands-decider serve StrandsAgents/strands-decider-2B-hobson-v19 --port 9000
INCIDENTPILOT_DECIDER_URL=
INCIDENTPILOT_DECIDER_TIMEOUT_S=10
# Selections with model confidence below this trigger collect_more_evidence / human review.
# The model card says confidence bands were calibrated on short classification tasks,
# so measure calibration on your own traffic before relying on a value.
INCIDENTPILOT_DECIDER_CONFIDENCE_THRESHOLD=0.60
