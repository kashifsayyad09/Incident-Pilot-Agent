{
  "openapi": "3.1.0",
  "info": {
    "title": "IncidentPilot AI API",
    "description": "Read-only AWS incident investigation with Strands Decider 2B tool selection.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/incidents": {
      "get": {
        "tags": [
          "incidents"
        ],
        "summary": "List Incidents",
        "operationId": "list_incidents_api_v1_incidents_get",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/incidents/{incident_id}": {
      "get": {
        "tags": [
          "incidents"
        ],
        "summary": "Get Incident",
        "operationId": "get_incident_api_v1_incidents__incident_id__get",
        "parameters": [
          {
            "name": "incident_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Incident Id"
            }
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/decision/status": {
      "get": {
        "tags": [
          "decision"
        ],
        "summary": "Decision Status",
        "operationId": "decision_status_api_v1_decision_status_get",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionStatus"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/decision/run": {
      "post": {
        "tags": [
          "decision"
        ],
        "summary": "Run Decision",
        "description": "Run real Decider 2B tool selection for an incident.\n\nThere is deliberately no fallback: if the model server is unavailable this returns\n503, and if it answers badly this returns 502. A non-model answer is never returned.",
        "operationId": "run_decision_api_v1_decision_run_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ComponentStatus": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "available": {
            "type": "boolean",
            "title": "Available"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "name",
          "available"
        ],
        "title": "ComponentStatus"
      },
      "DecisionOutcome": {
        "type": "string",
        "enum": [
          "tool_selected",
          "evidence_requested",
          "human_review"
        ],
        "title": "DecisionOutcome",
        "description": "What the confidence gate decided to do with the model's selection."
      },
      "DecisionRequest": {
        "properties": {
          "incident_id": {
            "type": "string",
            "title": "Incident Id"
          }
        },
        "type": "object",
        "required": [
          "incident_id"
        ],
        "title": "DecisionRequest"
      },
      "DecisionResult": {
        "properties": {
          "incident_id": {
            "type": "string",
            "title": "Incident Id"
          },
          "mode": {
            "$ref": "#/components/schemas/Mode"
          },
          "input_state": {
            "additionalProperties": true,
            "type": "object",
            "title": "Input State"
          },
          "state_text": {
            "type": "string",
            "title": "State Text",
            "description": "The exact text the model read."
          },
          "question": {
            "type": "string",
            "title": "Question"
          },
          "options": {
            "items": {
              "$ref": "#/components/schemas/ToolOption"
            },
            "type": "array",
            "title": "Options"
          },
          "selected": {
            "$ref": "#/components/schemas/ToolOption"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "probabilities": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Probabilities"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "roundtrip_ms": {
            "type": "number",
            "minimum": 0.0,
            "title": "Roundtrip Ms"
          },
          "confidence_threshold": {
            "type": "number",
            "title": "Confidence Threshold"
          },
          "meets_threshold": {
            "type": "boolean",
            "title": "Meets Threshold"
          },
          "outcome": {
            "$ref": "#/components/schemas/DecisionOutcome"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "tool_invoked": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Invoked",
            "description": "Always null until diagnostic tools exist (Phase 4)."
          }
        },
        "type": "object",
        "required": [
          "incident_id",
          "mode",
          "input_state",
          "state_text",
          "question",
          "options",
          "selected",
          "confidence",
          "probabilities",
          "roundtrip_ms",
          "confidence_threshold",
          "meets_threshold",
          "outcome",
          "reason"
        ],
        "title": "DecisionResult",
        "description": "One real Decider 2B inference. `confidence` and `probabilities` are the model's own\nnumbers, unmodified. `latency_ms` is the server-reported inference time (null if the\nserver did not report it); `roundtrip_ms` is measured by this API."
      },
      "DecisionStatus": {
        "properties": {
          "available": {
            "type": "boolean",
            "title": "Available"
          },
          "adapter": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Adapter"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason",
            "description": "Why the model is unavailable, when available is false."
          },
          "confidence_threshold": {
            "type": "number",
            "title": "Confidence Threshold"
          },
          "options": {
            "items": {
              "$ref": "#/components/schemas/ToolOption"
            },
            "type": "array",
            "title": "Options"
          }
        },
        "type": "object",
        "required": [
          "available",
          "confidence_threshold",
          "options"
        ],
        "title": "DecisionStatus"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": "0.1.0"
          },
          "mode": {
            "$ref": "#/components/schemas/Mode"
          },
          "components": {
            "items": {
              "$ref": "#/components/schemas/ComponentStatus"
            },
            "type": "array",
            "title": "Components"
          }
        },
        "type": "object",
        "required": [
          "mode",
          "components"
        ],
        "title": "HealthResponse"
      },
      "IncidentList": {
        "properties": {
          "mode": {
            "$ref": "#/components/schemas/Mode"
          },
          "incidents": {
            "items": {
              "$ref": "#/components/schemas/IncidentSummary"
            },
            "type": "array",
            "title": "Incidents"
          },
          "notice": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notice"
          }
        },
        "type": "object",
        "required": [
          "mode",
          "incidents"
        ],
        "title": "IncidentList"
      },
      "IncidentSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "affected_services": {
            "items": {
              "$ref": "#/components/schemas/ServiceKind"
            },
            "type": "array",
            "title": "Affected Services"
          },
          "mode": {
            "$ref": "#/components/schemas/Mode"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "category",
          "severity",
          "affected_services",
          "mode"
        ],
        "title": "IncidentSummary"
      },
      "Mode": {
        "type": "string",
        "enum": [
          "simulation",
          "live"
        ],
        "title": "Mode",
        "description": "Data source for incident evidence. Always surfaced to the UI."
      },
      "ServiceKind": {
        "type": "string",
        "enum": [
          "alb",
          "ec2",
          "rds",
          "cloudwatch"
        ],
        "title": "ServiceKind"
      },
      "Severity": {
        "type": "string",
        "enum": [
          "info",
          "warning",
          "critical"
        ],
        "title": "Severity"
      },
      "ToolOption": {
        "type": "string",
        "enum": [
          "investigate_load_balancer",
          "investigate_ec2",
          "investigate_database",
          "investigate_cloudwatch_logs",
          "collect_more_evidence"
        ],
        "title": "ToolOption",
        "description": "The typed option set Decider 2B chooses from."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
